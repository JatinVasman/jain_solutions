// =============================================================================
// PRISMA SCHEMA — STUB
// The full database schema will be defined in Phase 2 (Core Database Schema).
// This stub establishes the generator, datasource, and sets up Prisma correctly
// so the toolchain works from Phase 1.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


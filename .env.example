# =============================================================================
# MULTI-CATEGORY RENTAL MARKETPLACE — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env for local development.
# NEVER commit real credentials or secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION ENVIRONMENT
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PORT=4000
API_PREFIX=api/v1
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION (NEXT_PUBLIC_ prefixes are exposed to browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Rental Marketplace"

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rental_marketplace?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rental_marketplace
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# CACHE & MESSAGING INFRASTRUCTURE (Redis)
# Format: redis://[USER:PASSWORD@]HOST:PORT
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# SECURITY & CORS
# Comma-separated list of allowed origins for cross-origin resource sharing
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# LOGGING
# Options: fatal, error, warn, info, debug, verbose
# -----------------------------------------------------------------------------
LOG_LEVEL=info
